# ---------------------------------------------------------------------------
# Configuracion de ejemplo para backend/.env. Copiar a backend/.env y completar:
#   cp backend/.env.example backend/.env
# ---------------------------------------------------------------------------

# Puerto del servidor Express (default: 3000)
PORT=3000

# Origenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,https://tacs-2026-404-sol-not-found.onrender.com

# Broker RabbitMQ (notificaciones asincronas)
RABBITMQ_URL=amqp://localhost:5672

# Redis (cola BullMQ y cache)
REDIS_URL=redis://localhost:6379

# Cola a utilizar: "true" para BullMQ sobre Redis, "false" para cola en memoria
USE_BULLMQ=false

# Auth0 (obligatorio para autenticacion de rutas protegidas)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ROLES_CLAIM=

# Override de la URI del JWKS (opcional; solo para tests/proxies)
AUTH0_JWKS_URI=

# MongoDB
MONGO_USER=root
MONGO_PASSWORD=root
MONGO_DATABASE=solnotfound
MONGODB_URI=mongodb://root:root@localhost:27017/solnotfound?authSource=admin

# API key de Visual Crossing (solo backend; también configurar en Render)
VISUAL_CROSSING_API_KEY=

# Proveedor de clima legacy (binario tacs-linux-amd64)
LEGACY_WEATHER_URL=http://legacy-weather:8080
SESSION_TOKEN=
LEGACY_WEATHER_TOKEN=
