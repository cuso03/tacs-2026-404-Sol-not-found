TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RABBITMQ_URL=
OPENWEATHER_API_KEY=
REDIS_URL=redis://localhost:6379
USE_BULLMQ=false

# Auth0 (obligatorio en runtime; los tests generan su propio JWKS)
# Dominio del tenant sin esquema, ej: dev-abc123.us.auth0.com
AUTH0_DOMAIN=dev-v1az2thklfmx6nbb.us.auth0.com
# Identifier de la API creada en Auth0, ej: https://tacs-solnotfound/api
AUTH0_AUDIENCE=https://api.solnotfound.app
# Claim que contiene los roles (opcional; default https://solnotfound.app/roles)
AUTH0_ROLES_CLAIM=
# Override de la URI del JWKS (opcional; solo para tests/proxies)
AUTH0_JWKS_URI=

# MongoDB
MONGO_USER=root
MONGO_PASSWORD=root
MONGO_DATABASE=solnotfound
MONGODB_URI=mongodb://root:root@localhost:27017/solnotfound?authSource=admin
