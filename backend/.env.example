TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RABBITMQ_URL=
OPENWEATHER_API_KEY=
REDIS_URL=redis://localhost:6379
USE_BULLMQ=false

# CORS — origenes permitidos, separados por comas.
# Default en local: http://localhost:5173
# Default en produccion: https://tacs-2026-404-sol-not-found.onrender.com
CORS_ORIGINS=

# Documentacion (Swagger UI en /api-docs y /openapi.json).
# Habilitada por defecto salvo NODE_ENV=production; ENABLE_SWAGGER=false la apaga siempre.
ENABLE_SWAGGER=

# Auth0 (obligatorio en runtime; los tests generan su propio JWKS)
# Dominio del tenant sin esquema, ej: dev-abc123.us.auth0.com
AUTH0_DOMAIN=dev-v1az2thklfmx6nbb.us.auth0.com
# Identifier de la API creada en Auth0. Debe existir en el tenant, si no el
# login falla con "Service not found" y la API responde 401.
AUTH0_AUDIENCE=https://api.solnotfound.app
# Claim que contiene los roles (opcional; default https://solnotfound.app/roles)
AUTH0_ROLES_CLAIM=
# Override de la URI del JWKS (opcional; solo para tests/proxies)
AUTH0_JWKS_URI=

# MongoDB
MONGO_USER=root
MONGO_PASSWORD=root
MONGO_DATABASE=solnotfound
MONGODB_URI=mongodb://root:root@localhost:27017/solnotfound?authSource=admin
