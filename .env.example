# Complemento de docker-compose.yml (gitignored). Copiar a `.env` en la raiz:
#   cp .env.example .env
# El frontend se construye con estas variables (son valores publicos de la SPA,
# no secretos).

# Dominio del tenant Auth0 sin esquema; debe coincidir con AUTH0_DOMAIN de backend/.env
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com
# Client ID de la aplicacion SPA registrada en Auth0
VITE_AUTH0_CLIENT_ID=tu-client-id-de-spa
# Identifier de la API; debe coincidir con AUTH0_AUDIENCE de backend/.env
VITE_AUTH0_AUDIENCE=https://tacs-solnotfound/api
