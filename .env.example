# Complemento de docker-compose.yml (gitignored). Copiar a `.env` en la raiz:
#   cp .env.example .env
# El frontend se construye con estas variables (son valores publicos de la SPA,
# no secretos).

# Dominio del tenant Auth0 sin esquema; debe coincidir con AUTH0_DOMAIN de backend/.env
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com
# Client ID de la aplicacion SPA registrada en Auth0
VITE_AUTH0_CLIENT_ID=tu-client-id-de-spa
# Identifier de la API; debe coincidir con AUTH0_AUDIENCE de backend/.env
VITE_AUTH0_AUDIENCE=https://api.solnotfound.app
# Si el identifier real de la API en tu tenant es otro, cambialo aqui Y en
# AUTH0_AUDIENCE de backend/.env: si divergen, el backend responde 401.

# Bearer para llamadas del backend al RPC legacy; no reemplaza el token.json de sesión OAuth.
SESSION_TOKEN=

# Solo si MongoDB 8 rechaza arrancar por incompatibilidad TCMalloc/kernel:
# MONGO_GLIBC_TUNABLES=glibc.pthread.rseq=1

# Puerto publicado de Redis; cambiar si ya hay un Redis local en 6379.
REDIS_PORT=6379
